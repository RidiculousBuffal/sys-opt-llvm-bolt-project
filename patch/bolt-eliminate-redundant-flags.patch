+Error EliminateRedundantFlags::runOnFunctions(BinaryContext &BC) {
+  if (!BC.isX86())
+    return Error::success();
+
+  std::atomic<uint64_t> NumStatic{0};
+  std::atomic<uint64_t> NumDynamic{0};
+  std::atomic<uint64_t> NumBytes{0};
+  std::atomic<uint64_t> NumBranches{0};
+  std::atomic<uint64_t> NumTests{0};
+  std::atomic<uint64_t> NumProducers{0};
+  std::atomic<uint64_t> NumEquivalent{0};
+  std::atomic<uint64_t> NumFlagsLive{0};
+
+  // Building a call graph is not necessary for this local optimization.  With
+  // a null call graph, RegAnalysis is conservative about calls; this pass
+  // stops at calls anyway.
+  RegAnalysis RA(BC, &BC.getBinaryFunctions(), nullptr);
+
+  auto Skip = [&](const BinaryFunction &BF) { return !shouldOptimize(BF); };
+
+  auto Work = [&](BinaryFunction &BF,
+                  MCPlusBuilder::AllocatorIdTy AllocId) {
+    BinaryContext &BFBC = BF.getBinaryContext();
+    MCPlusBuilder *MIB = BFBC.MIB.get();
+    const MCPhysReg FlagsReg = MIB->getFlagsReg();
+    const unsigned NumRegs = BFBC.MRI->getNumRegs();
+
+    DataflowInfoManager Info(BF, &RA, nullptr, AllocId);
+    LivenessAnalysis &LA = Info.getLivenessAnalysis();
+
+    for (BinaryBasicBlock &BB : BF) {
+      if (BB.isLandingPad())
+        continue;
+
+      for (auto II = BB.begin(); II != BB.end();) {
+        MCInst &Branch = *II;
+        if (!MIB->isConditionalBranch(Branch)) {
+          ++II;
+          continue;
+        }
+        NumBranches.fetch_add(1, std::memory_order_relaxed);
+
+        // Find the test/cmp immediately before the branch, ignoring
+        // pseudo/CFI instructions.
+        auto TI = II;
+        bool FoundTest = false;
+        while (TI != BB.begin()) {
+          --TI;
+          if (MIB->isPseudo(*TI) || MIB->isCFI(*TI))
+            continue;
+          FoundTest = true;
+          break;
+        }
+        if (!FoundTest) {
+          ++II;
+          continue;
+        }
+
+        MCInst &Test = *TI;
+        std::optional<MCPhysReg> TestedReg = MIB->getTestedRegister(Test);
+        if (!TestedReg) {
+          ++II;
+          continue;
+        }
+        NumTests.fetch_add(1, std::memory_order_relaxed);
+
+        // Do not remove the first real instruction of a block; it may be a
+        // branch target or entry point.
+        if (&Test == BB.getFirstNonPseudoInstr()) {
+          ++II;
+          continue;
+        }
+
+        // Find the producer of the flags.  We stop at the first instruction
+        // that writes EFLAGS or the tested register, or at a control-flow
+        // boundary.
+        MCInst *Producer = nullptr;
+        auto PI = TI;
+        while (PI != BB.begin()) {
+          --PI;
+          MCInst &Prev = *PI;
+          if (MIB->isPseudo(Prev) || MIB->isCFI(Prev))
+            continue;
+
+          BitVector Written(NumRegs, false);
+          MIB->getWrittenRegs(Prev, Written);
+
+          if (Written.test(FlagsReg)) {
+            Producer = &Prev;
+            break;
+          }
+
+          if (Written.anyCommon(MIB->getAliases(*TestedReg, false)))
+            break;
+
+          if (MIB->isBranch(Prev) || MIB->isCall(Prev) ||
+              MIB->isReturn(Prev))
+            break;
+
+          // Non-flag-writing instruction (mov/lea/nop): keep looking.
+        }
+
+        if (!Producer) {
+          ++II;
+          continue;
+        }
+        NumProducers.fetch_add(1, std::memory_order_relaxed);
+
+        if (!MIB->isRedundantFlagTest(*Producer, Test, Branch)) {
+          ++II;
+          continue;
+        }
+        NumEquivalent.fetch_add(1, std::memory_order_relaxed);
+
+        // Conservatively require EFLAGS to be dead after the branch.  This
+        // ensures that TEST's CF=OF=0 writes are not observed by later code.
+        if (LA.getLiveOut(Branch).test(FlagsReg)) {
+          NumFlagsLive.fetch_add(1, std::memory_order_relaxed);
+          ++II;
+          continue;
+        }
+
+        uint64_t Size = 0;
+        if (std::optional<uint32_t> S = MIB->getSize(Test))
+          Size = *S;
+        const uint64_t Count = BB.getKnownExecutionCount();
+
+        if (opts::Verbosity > 0)
+          BFBC.errs() << "DELETED redundant test in " << BF.getPrintName()
+                      << " (count=" << Count << ")\n";
+
+        NumStatic.fetch_add(1, std::memory_order_relaxed);
+        NumDynamic.fetch_add(Count, std::memory_order_relaxed);
+        NumBytes.fetch_add(Size, std::memory_order_relaxed);
+
+        // eraseInstruction() returns an iterator to the next instruction,
+        // which is the branch.  Continue without ++II so the branch is
+        // inspected again (it will simply be skipped).
+        II = BB.eraseInstruction(TI);
+      }
+    }
+  };
+
+  ParallelUtilities::runOnEachFunctionWithUniqueAllocId(
+      BC, ParallelUtilities::SchedulingPolicy::SP_INST_LINEAR, Work, Skip,
+      "eliminate-redundant-flags");
+
+  if (opts::Verbosity > 0)
+    BC.outs() << "BOLT-INFO: eliminate-redundant-flags: branches=" << NumBranches
+              << " tests=" << NumTests << " producers=" << NumProducers
+              << " equivalent=" << NumEquivalent
+              << " flags-live=" << NumFlagsLive << "\n";
+  if (NumStatic) {
+    BC.outs() << "BOLT-INFO: eliminate-redundant-flags: removed "
+              << NumStatic << " static test/cmp instruction(s), "
+              << NumDynamic << " dynamic execution(s)";
+    if (NumBytes)
+      BC.outs() << ", " << NumBytes << " byte(s)";
+    BC.outs() << "\n";
+  }
+
+  return Error::success();
+}
