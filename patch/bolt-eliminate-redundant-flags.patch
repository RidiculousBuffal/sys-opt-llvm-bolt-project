+  std::optional<MCPhysReg>
+  getTestedRegister(const MCInst &Inst) const override {
+    switch (Inst.getOpcode()) {
+    case X86::TEST8rr:
+    case X86::TEST16rr:
+    case X86::TEST32rr:
+    case X86::TEST64rr: {
+      if (MCPlus::getNumPrimeOperands(Inst) != 2)
+        return std::nullopt;
+      const MCOperand &Op0 = Inst.getOperand(0);
+      const MCOperand &Op1 = Inst.getOperand(1);
+      if (!Op0.isReg() || !Op1.isReg() || Op0.getReg() != Op1.getReg())
+        return std::nullopt;
+      return Op0.getReg();
+    }
+    case X86::CMP8ri:
+    case X86::CMP16ri:
+    case X86::CMP16ri8:
+    case X86::CMP32ri:
+    case X86::CMP32ri8:
+    case X86::CMP64ri8:
+    case X86::CMP64ri32: {
+      if (MCPlus::getNumPrimeOperands(Inst) != 2)
+        return std::nullopt;
+      const MCOperand &RegOp = Inst.getOperand(0);
+      const MCOperand &ImmOp = Inst.getOperand(1);
+      if (!RegOp.isReg() || !ImmOp.isImm() || ImmOp.getImm() != 0)
+        return std::nullopt;
+      return RegOp.getReg();
+    }
+    default:
+      return std::nullopt;
+    }
+  }
+
+  bool isRedundantFlagTest(const MCInst &Producer, const MCInst &Test,
+                           const MCInst &Branch) const override {
+    auto TestedReg = getTestedRegister(Test);
+    if (!TestedReg)
+      return false;
+
+    const unsigned CC = getCondCode(Branch);
+    if (CC == X86::COND_INVALID)
+      return false;
+
+    const unsigned Opcode = Producer.getOpcode();
+
+    // A preceding TEST/CMP can also make the following TEST/CMP redundant.
+    if (X86::isTEST(Opcode) || X86::isCMP(Opcode)) {
+      auto ProducerTestedReg = getTestedRegister(Producer);
+      return ProducerTestedReg && *ProducerTestedReg == *TestedReg;
+    }
+
+    const MCInstrDesc &Desc = Info->get(Opcode);
+    if (Desc.getNumDefs() != 1 || Producer.getNumOperands() == 0)
+      return false;
+
+    const MCOperand &DestOp = Producer.getOperand(0);
+    if (!DestOp.isReg() || DestOp.getReg() != *TestedReg)
+      return false;
+
+    // AND/OR/XOR set CF=OF=0 and derive ZF/SF/PF from the result, exactly like
+    // TEST r,r.  They are equivalent for every Jcc condition.
+    if (X86::isAND(Opcode) || X86::isOR(Opcode) || X86::isXOR(Opcode))
+      return true;
+
+    // ADD/SUB/INC/DEC/NEG are only equivalent to TEST r,r for ZF/SF/PF.
+    // Their CF/OF do not match TEST's CF=OF=0.
+    if (X86::isADD(Opcode) || X86::isSUB(Opcode) || X86::isINC(Opcode) ||
+        X86::isDEC(Opcode) || X86::isNEG(Opcode))
+      return isZSPCond(CC);
+
+    return false;
+  }
