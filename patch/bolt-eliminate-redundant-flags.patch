+/// Eliminate TEST/CMP instructions that redundantly recompute flags already
+/// produced by a preceding flag-setting instruction.
+///
+/// Example:
+///     addq %r15, %rdx
+///     testq %rdx, %rdx     <- redundant for jns
+///     jns  .Lnext
+///
+/// The pass only runs on X86 and only deletes an instruction after checking:
+///   * the producer writes the same register that is tested;
+///   * no instruction between producer and test writes flags or the register;
+///   * the condition code used by the branch is covered by the producer;
+///   * EFLAGS is dead after the branch.
+class EliminateRedundantFlags : public BinaryFunctionPass {
+public:
+  explicit EliminateRedundantFlags(const cl::opt<bool> &PrintPass)
+      : BinaryFunctionPass(PrintPass) {}
+
+  const char *getName() const override {
+    return "eliminate-redundant-flags";
+  }
+
+  Error runOnFunctions(BinaryContext &BC) override;
+};
