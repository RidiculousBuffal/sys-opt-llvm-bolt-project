+/// Return true if the condition code only depends on ZF, SF, or PF.
+bool isZSPCond(unsigned CC) {
+  switch (CC) {
+  case X86::COND_E:
+  case X86::COND_NE:
+  case X86::COND_S:
+  case X86::COND_NS:
+  case X86::COND_P:
+  case X86::COND_NP:
+    return true;
+  default:
+    return false;
+  }
+}
